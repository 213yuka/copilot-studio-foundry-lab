# Local workspace settings
# Note: .github/ は CI/CD ワークフロー (.github/workflows/*.yml) や CODEOWNERS の
# 正式管理のため、追跡対象に含めます。除外したい場合はパス単位で指定してください。
.vscode/

# Local verification / scratch area
playground/

# Secrets and local environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Dependency and build outputs, if added later
node_modules/
dist/
build/
coverage/

# Playwright persistent browser profiles (contain cookies / session tokens — must NOT be committed)
**/.pw-profile/
**/.pw-profile-cs/

# Python caches and virtual environments, if added later
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
