# Local workspace settings
.vscode/

# Under .github/: Copilot customizations (instructions / skills / copilot-instructions.md) are not committed.
# Other contents such as workflows (.github/workflows/) should be committed, so do not ignore the entire .github/ folder.
.github/copilot-instructions.md
.github/instructions/
.github/skills/

# Local verification / scratch area
playground/

# Secrets and local environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Dependency and build outputs, if added later
node_modules/
dist/
build/
coverage/

# Playwright persistent browser profiles (contain cookies / session tokens — must NOT be committed)
**/.pw-profile/
**/.pw-profile-cs/

# Python caches and virtual environments, if added later
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
